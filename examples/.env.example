# Copie para .env (ou exporte no shell) e preencha com seus dados.
# NUNCA faça commit de valores reais — .env já está no .gitignore.

# Ambiente: 1 = Produção, 2 = Homologação (produção restrita)
NFSE_AMBIENTE=2

# Certificado digital A1
NFSE_CERT_PFX=/caminho/para/certificado.pfx
NFSE_CERT_SENHA=

# Dados do emissor
NFSE_CNPJ=
NFSE_RAZAO_SOCIAL=
NFSE_COD_MUN=4216909

# Emissão
NFSE_SERIE=900
NFSE_NUMERO_DPS=1
NFSE_VER_APLIC=MeuSistema/1.0.0
